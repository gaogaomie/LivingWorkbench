# Public web configuration. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=/api/v1

# Server-only configuration.
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DATABASE_PATH=../../data/daily-life.sqlite
BACKUP_DIRECTORY=../../data/backups
UPLOAD_DIR=../../uploads
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
AI_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
