{
  "appId": "local.daily-life.workbench",
  "productName": "日常集",
  "electronVersion": "44.1.1",
  "directories": {
    "app": "apps/desktop/runtime",
    "output": "apps/desktop/release"
  },
  "files": ["dist/**/*", "package.json"],
  "asar": true,
  "asarUnpack": ["**/*.node", "**/sharp/**/*", "**/@img/**/*", "**/argon2/**/*"],
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.lifestyle",
    "identity": null,
    "icon": "apps/web/public/brand/module-ip-transparent/J2-overview-owl-right.png"
  },
  "artifactName": "DailyLife-${version}-${arch}.${ext}",
  "win": {
    "target": ["nsis"],
    "executableName": "DailyLife",
    "icon": "apps/web/public/brand/module-ip-transparent/J2-overview-owl-right.png",
    "artifactName": "DailyLife-${version}-windows-${arch}-setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "日常集"
  },
  "npmRebuild": false,
  "electronDist": "node_modules/electron/dist"
}
